# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_API_KEY=your-firebase-api-key

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret
